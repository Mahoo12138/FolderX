<Window x:Class="FolderX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:FolderX.Converters"
        mc:Ignorable="d"
        Title="FolderX"
        Height="720" Width="1100"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:BoolToGrayConverter    x:Key="BoolToGrayConverter"/>

        <!-- GroupBox 通用样式 -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4,4,4,4"/>
            <Setter Property="Padding" Value="6,4,6,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Label 通用 -->
        <Style TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0,4,0"/>
        </Style>

        <!-- TextBox 通用 -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>

        <!-- 操作按钮 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- 侧边小按钮 -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════════ 状态栏 ═══════════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Margin="4,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="作者：Mahoo12138" Margin="0,0,12,0" Foreground="Gray"/>
                    <TextBlock Text=".NET 8.0" Margin="0,0,8,0" Foreground="Gray"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══════════════════ 底部操作栏 ═══════════════════ -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource ActionBtn}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存 desktop.ini" Style="{StaticResource ActionBtn}" Command="{Binding SaveDesktopIniCommand}"/>
                    <Button Content="应用所有设置" Style="{StaticResource ActionBtn}" Command="{Binding ApplyAllCommand}"/>
                    <Button Content="退出" Style="{StaticResource ActionBtn}" Command="{Binding ExitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ 主内容区 ═══════════════════ -->
        <DockPanel DockPanel.Dock="Top">

            <!-- ── 顶部：目标文件夹 ── -->
            <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="目标文件夹：" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             KeyDown="FolderPathBox_KeyDown"/>
                    <Button Grid.Column="2" Content="浏览..." Style="{StaticResource ActionBtn}"
                            Command="{Binding BrowseFolderCommand}"/>
                    <Button Grid.Column="3" Content="打开" Style="{StaticResource ActionBtn}"
                            Command="{Binding OpenFolderCommand}"/>
                </Grid>
            </Border>

            <!-- ── 三列主体 ── -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="200"/>
                    <ColumnDefinition Width="220" MinWidth="200"/>
                    <ColumnDefinition Width="*"   MinWidth="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════ 左栏：基本属性 ══════════════ -->
                <GroupBox Grid.Column="0" Grid.Row="0" Header="基本属性">
                    <StackPanel>
                        <Label Content="文件夹名称：" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,4,6"/>

                        <Label Content="备注：" FontWeight="SemiBold"/>
                        <Grid Margin="4,0,4,2">
                            <TextBox x:Name="CommentBox"
                                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80" VerticalScrollBarVisibility="Auto"
                                     MaxLength="500"/>
                        </Grid>
                        <TextBlock HorizontalAlignment="Right" Margin="0,0,8,6" Foreground="Gray" FontSize="11">
                            <Run Text="{Binding CommentLength, Mode=OneWay}"/>
                            <Run Text="/ 500"/>
                        </TextBlock>

                        <!-- 当前图标（只读预览，编辑请到中栏） -->
                        <Label Content="当前图标：" FontWeight="SemiBold"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                Width="56" Height="56" HorizontalAlignment="Left"
                                Margin="4,0,4,8" Background="#F8F8F8"
                                ToolTip="当前文件夹图标（在右侧文件夹图标设置中编辑）">
                            <Image Source="{Binding FolderIconImage}" Stretch="Uniform" Margin="4"/>
                        </Border>

                        <!-- 时间戳 -->
                        <Grid Margin="4,0,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="创建时间：" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                       Text="{Binding CreatedTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="修改时间：" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                       Text="{Binding ModifiedTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                        </Grid>

                        <!-- 属性复选框 -->
                        <Label Content="属性：" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                            <CheckBox Content="只读(R)" IsChecked="{Binding IsReadOnly}" Margin="0,0,10,0"/>
                            <CheckBox Content="隐藏(H)" IsChecked="{Binding IsHidden}"   Margin="0,0,10,0"/>
                            <CheckBox Content="系统(S)" IsChecked="{Binding IsSystem}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 中栏：文件夹图标设置 ══════════════ -->
                <GroupBox Grid.Column="1" Grid.Row="0" Header="文件夹图标设置">
                    <StackPanel>
                        <RadioButton Content="使用默认图标" IsChecked="{Binding UseDefaultIcon}"
                                     Margin="4,6,4,4" FontSize="12"/>
                        <RadioButton Content="自定义图标"   IsChecked="{Binding UseCustomIcon}"
                                     Margin="4,0,4,8"  FontSize="12"/>

                        <!-- 图标文件路径 -->
                        <Grid Margin="4,0,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding IconFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCustomIcon}" VerticalContentAlignment="Center" Height="26"/>
                            <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SideBtn}"
                                    IsEnabled="{Binding UseCustomIcon}" Command="{Binding ChangeIconCommand}"/>
                        </Grid>

                        <!-- 图标预览 -->
                        <Label Content="图标预览：" FontWeight="SemiBold"/>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                Width="80" Height="80" HorizontalAlignment="Left"
                                Margin="4,0,4,8" Background="#F8F8F8"
                                AllowDrop="True"
                                DragOver="IconPreview_DragOver"
                                Drop="IconPreview_Drop"
                                ToolTip="可将 .ico/.dll/.exe 拖到此处设为自定义图标">
                            <Image Source="{Binding IconPreviewImage}" Stretch="Uniform" Margin="6"/>
                        </Border>

                        <Button Content="从系统图标库选择..." Style="{StaticResource ActionBtn}"
                                HorizontalAlignment="Left" Margin="4,2"
                                ToolTip="从 shell32.dll / imageres.dll 等系统图标库选择内置图标"
                                Command="{Binding ExtractSystemIconCommand}"/>
                        <Button Content="恢复默认图标" Style="{StaticResource ActionBtn}"
                                HorizontalAlignment="Left" Margin="4,2"
                                Command="{Binding RestoreDefaultIconCommand}"/>
                    </StackPanel>
                </GroupBox>

                <!-- ══════════════ 右栏：显示设置 + 列设置 ══════════════ -->
                <GroupBox Grid.Column="2" Grid.Row="0" Header="文件夹显示设置 (desktop.ini 布局)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：下拉 + 复选 -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="视图模式："/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="24" Margin="0,3"
                                          ItemsSource="{Binding ViewModes}"
                                          SelectedItem="{Binding ViewMode}"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="排序方式："/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Height="24" Margin="0,3"
                                          ItemsSource="{Binding SortByOptions}"
                                          SelectedItem="{Binding SortBy}"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="分组方式："/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Height="24" Margin="0,3"
                                          ItemsSource="{Binding GroupByOptions}"
                                          SelectedItem="{Binding GroupBy}"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="排列方式："/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Height="24" Margin="0,3"
                                          ItemsSource="{Binding SortDirections}"
                                          SelectedItem="{Binding SortDirection}"/>
                            </Grid>

                            <CheckBox Content="显示隐藏的文件和文件夹" IsChecked="{Binding ShowHiddenFiles}"  Margin="4,4"/>
                            <CheckBox Content="显示文件扩展名"         IsChecked="{Binding ShowFileExtensions}" Margin="4,4"/>
                            <CheckBox Content="显示系统文件"           IsChecked="{Binding ShowSystemFiles}"  Margin="4,4"/>
                        </StackPanel>

                        <!-- 右：列设置 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Content="列设置（详细信息视图）：" FontWeight="SemiBold" Padding="0,4,0,2"/>

                            <ListBox Grid.Row="1" x:Name="ColumnListBox"
                                     ItemsSource="{Binding Columns}"
                                     SelectedItem="{Binding SelectedColumn}"
                                     MinHeight="120" MaxHeight="200"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsVisible}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding IsVisible, Converter={StaticResource BoolToGrayConverter}}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="上移" Style="{StaticResource SideBtn}" Command="{Binding MoveColumnUpCommand}"/>
                                    <Button Content="下移" Style="{StaticResource SideBtn}" Command="{Binding MoveColumnDownCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="显示" Style="{StaticResource SideBtn}" Command="{Binding ShowColumnCommand}"/>
                                    <Button Content="隐藏" Style="{StaticResource SideBtn}" Command="{Binding HideColumnCommand}"/>
                                </StackPanel>
                                <Button Content="重置" Style="{StaticResource SideBtn}" HorizontalAlignment="Right" Command="{Binding ResetColumnsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- ══════════════ 底部三栏（desktop.ini 状态 + 注册表 + 提示）══════════════ -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- desktop.ini 状态 -->
                    <GroupBox Grid.Column="0" Header="desktop.ini 状态">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="状态：" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                       Text="{Binding IniStatus}"
                                       Foreground="{Binding IniStatus, Converter={StaticResource StatusToColorConverter}}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="路径：" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                       Text="{Binding IniPath}" TextTrimming="CharacterEllipsis"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="大小：" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Text="{Binding IniSize}"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="修改时间：" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Text="{Binding IniModifiedTime}"/>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="备份 desktop.ini" Style="{StaticResource SideBtn}" Command="{Binding BackupIniCommand}"/>
                                <Button Content="还原 desktop.ini" Style="{StaticResource SideBtn}" Command="{Binding RestoreIniCommand}"/>
                                <Button Content="删除 desktop.ini" Style="{StaticResource SideBtn}" Command="{Binding DeleteIniCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Shell Bags 缓存（高级/可选） -->
                    <GroupBox Grid.Column="1" Header="Shell Bags 缓存（高级）">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="状态：" FontSize="11"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                       Text="{Binding BagsStatus}"
                                       Foreground="{Binding BagsStatus, Converter={StaticResource StatusToColorConverter}}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="缓存项数：" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Text="{Binding BagsCount}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                       FontSize="10" Foreground="#666" TextWrapping="Wrap"
                                       Text="Explorer 缓存了每个文件夹的视图记忆，可能导致 desktop.ini 修改后不刷新。清空后重启 Explorer 生效。"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="刷新状态"   Style="{StaticResource SideBtn}" Command="{Binding RefreshBagsStatusCommand}"/>
                                <Button Content="清空 Bags 缓存" Style="{StaticResource SideBtn}" Command="{Binding ClearBagsCacheCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 提示框 -->
                    <Border Grid.Column="2" Margin="4" Background="#FFFCE8" BorderBrush="#E8D080" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="提示" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555555"
                                       Text="可直接将文件夹拖入窗口加载；将 .ico/.dll/.exe 拖到图标预览区可设为自定义图标。修改 desktop.ini 后如未生效，请清空 Shell Bags 缓存并重启 Explorer。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
